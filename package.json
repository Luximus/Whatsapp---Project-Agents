{
  "name": "luxisoft-whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "start:learning": "node dist/src/learningWorker.js",
    "learning:run": "tsx scripts/run-learning.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest --maxWorkers=1 --no-file-parallelism",
    "db:apply": "tsx scripts/db-apply.ts",
    "test:dependencies": "node --test test/dependency-security.test.mjs test/server-dependency-security.test.mjs",
    "test:firebase": "node --import tsx --test test/firebase-sdk-security.test.mjs",
    "audit:security": "npm audit --include=dev --audit-level=high",
    "test:toolchain": "node --test test/toolchain-*.test.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@react-email/components": "^1.0.10",
    "@react-email/render": "^2.0.4",
    "dotenv": "^17.2.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.0.1",
    "firebase-admin": "^13.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.1.6",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.2.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "4.1.12",
    "vite": "7.3.6"
  },
  "overrides": {
    "fast-xml-parser": "5.11.1",
    "protobufjs": "7.6.6",
    "websocket-driver": "0.7.5",
    "@fastify/busboy": "3.2.3",
    "@grpc/grpc-js": "1.14.6",
    "find-my-way": "9.10.0",
    "form-data@2.x": "2.5.6",
    "fast-uri@3.x": "3.1.8",
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@5.x": "5.0.12",
    "js-yaml@4.x": "4.3.2",
    "nanoid@3.x": "3.3.20",
    "postcss@8.x": "8.5.30",
    "source-map-js": "1.2.2"
  }
}
