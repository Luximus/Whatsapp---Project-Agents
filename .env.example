# -----------------------------
# Server
# -----------------------------
PORT=4010
HOST=0.0.0.0
LOG_LEVEL=info

# -----------------------------
# Database
# -----------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp

# CSV list. Example: http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# -----------------------------
# Firebase Admin
# use una opcion
# -----------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# -----------------------------
# WhatsApp Cloud API
# -----------------------------
WHATSAPP_VERIFY_NUMBER_E164=+573001112233
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# -----------------------------
# Project resolution
# -----------------------------
WHATSAPP_DEFAULT_PROJECT=luxisoft
# Enrutar mensajes sin codigo OTP al asistente multi-agente (agents/<proyecto>/).
# Default false: el webhook solo procesa codigos de verificacion.
WHATSAPP_AGENT_ENABLED=false
# Memoria de conversacion del agente (historial por numero en Postgres si hay BD,
# si no en memoria). TTL = ventana de inactividad antes de olvidar la charla.
WHATSAPP_AGENT_MEMORY_TTL_SECONDS=1800
WHATSAPP_AGENT_MEMORY_MAX_MESSAGES=20

# -----------------------------
# OpenAI audio transcription
# -----------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_AUDIO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------
# Capa multi-proveedor de IA
# Proveedores: openai | anthropic | gemini | deepseek | minimax | grok
# -----------------------------
AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=
AI_TRANSCRIPTION_PROVIDER=openai
# Proveedor TTS (texto→voz) para responder con nota de voz:
# openai | deepseek | grok (compat. OpenAI) | gemini | minimax
AI_SPEECH_PROVIDER=openai

# Nombre del asistente (FEMENINO) por proveedor de chat: la identidad cambia
# según AI_CHAT_PROVIDER y es siempre la misma para ese proveedor.
OPENAI_ASSISTANT_NAME=Luisa
ANTHROPIC_ASSISTANT_NAME=Valeria
GEMINI_ASSISTANT_NAME=Sofía
DEEPSEEK_ASSISTANT_NAME=Camila
MINIMAX_ASSISTANT_NAME=Daniela
GROK_ASSISTANT_NAME=Valentina

# TTS OpenAI-compat: response_format "opus" => audio/ogg (nota de voz real en
# WhatsApp). mp3/aac/flac/wav/pcm se envían como audio normal reproducible.
# Voz FEMENINA (nova, shimmer, coral, sage son femeninas en OpenAI).
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=nova
OPENAI_SPEECH_FORMAT=opus

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# TTS Gemini: devuelve PCM, se envuelve en WAV (no es nota de voz, audio normal).
# Voz FEMENINA (Kore, Aoede, Leda son femeninas en Gemini).
GEMINI_SPEECH_MODEL=gemini-2.5-flash-preview-tts
GEMINI_SPEECH_VOICE=Kore

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_CHAT_MODEL=deepseek-chat

MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_CHAT_MODEL=MiniMax-Text-01
# TTS MiniMax (t2a_v2): exige MINIMAX_GROUP_ID. Devuelve mp3 (audio normal).
# Voz FEMENINA (female-* en MiniMax).
MINIMAX_SPEECH_MODEL=speech-02-hd
MINIMAX_SPEECH_VOICE=female-shaonv
MINIMAX_GROUP_ID=

GROK_API_KEY=
GROK_BASE_URL=
GROK_CHAT_MODEL=grok-3

# -----------------------------
# Webhook UX behavior
# -----------------------------
WHATSAPP_REPLY_CONTEXT_PROBABILITY=35
WHATSAPP_MARK_AS_READ_PROBABILITY=100
WHATSAPP_TYPING_INDICATOR_PROBABILITY=100
# Modo de respuesta del asistente IA por probabilidad ponderada (se normalizan):
# texto plano | nota de voz (TTS) | texto citando el mensaje del usuario.
# El peso de audio solo se anula si no hay proveedor TTS configurado.
WHATSAPP_REPLY_TEXT_PROBABILITY=35
WHATSAPP_REPLY_AUDIO_PROBABILITY=35
WHATSAPP_REPLY_QUOTED_PROBABILITY=30

# -----------------------------
# SMTP reports
# -----------------------------
SMTP_HOST=mail.luxisoft.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@luxisoft.com
SMTP_PASS=
SMTP_FROM=support@luxisoft.com
MEETING_QUOTE_EMAIL_TO=quote@luxipanel.com
SUPPORT_TICKET_EMAIL_TO=support@luxisoft.com

# -----------------------------
# Daily report scheduler
# -----------------------------
REPORT_EMAIL_TO=reports@luxisoft.com
REPORT_CRON=59 23 * * *
REPORT_TIMEZONE=America/Bogota
REPORT_LOGO_URL=https://imagedelivery.net/juOGhpzwqbGB3xBvV9fTTQ/e0ebede4-9c85-419b-57f6-40d8fc898000/product

# -----------------------------
# Bridge projects (auth + callback per project)
# -----------------------------
# JSON object.
# Example:
# {"luxichat":{"api_key":"change_me_luxichat","callback_url":"https://api.luxichat.com/api/integrations/whatsapp/bridge","callback_secret":"change_me_cb_1"},"navai":{"api_key":"change_me_navai","callback_url":"https://api.navai.com/api/integrations/whatsapp/bridge","callback_secret":"change_me_cb_2"}}
BRIDGE_PROJECTS_JSON={"luxichat":{"api_key":"change_me_luxichat","callback_url":"https://api.luxichat.com/api/integrations/whatsapp/bridge","callback_secret":"change_me_cb_1"},"navai":{"api_key":"change_me_navai","callback_url":"https://api.navai.com/api/integrations/whatsapp/bridge","callback_secret":"change_me_cb_2"},"luxisoft":{"api_key":"change_me_luxisoft","callback_url":"https://api.luxisoft.com/api/integrations/whatsapp/bridge","callback_secret":"change_me_cb_3"}}

# OTP/session behavior
BRIDGE_OTP_TTL_SECONDS=300
BRIDGE_OTP_MAX_ATTEMPTS=5

# Callback delivery behavior
BRIDGE_CALLBACK_TIMEOUT_MS=7000
BRIDGE_EVENT_MAX_RETRIES=6
BRIDGE_EVENT_RETRY_BASE_SECONDS=20
BRIDGE_EVENT_DISPATCH_LIMIT=50

# Optional token for manual/cron dispatch endpoint (/api/bridge/events/dispatch)
BRIDGE_DISPATCH_TOKEN=

# Backend de almacenamiento del Bridge: memory (default) | postgres
BRIDGE_STORE=memory
